{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow asset-reference contract v1 (DRAFT, NOT production authorized)",
  "description": "Additive versioned transport contract; server verification, authorization and data minimization required by integration adapters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_id",
    "source_product",
    "revision",
    "creator_id",
    "visibility",
    "rights_state"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_product": {
      "const": "tourify"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "creator_id": {
      "type": "string",
      "format": "uuid"
    },
    "visibility": {
      "enum": [
        "public-preview",
        "private",
        "removed"
      ]
    },
    "rights_state": {
      "enum": [
        "approved",
        "pending",
        "denied"
      ]
    },
    "preview_url": {
      "type": "string",
      "format": "uri"
    },
    "license_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
