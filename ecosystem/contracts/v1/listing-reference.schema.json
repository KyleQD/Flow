{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow listing-reference contract v1 (DRAFT, NOT production authorized)",
  "description": "Additive versioned transport contract; server verification, authorization and data minimization required by integration adapters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "listing_id",
    "source_product",
    "seller_id",
    "revision",
    "title",
    "state",
    "seller_mode"
  ],
  "properties": {
    "listing_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_product": {
      "const": "tourify"
    },
    "seller_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "published",
        "paused",
        "removed"
      ]
    },
    "seller_mode": {
      "enum": [
        "fixed",
        "booking",
        "quote"
      ]
    },
    "public_url": {
      "type": "string",
      "format": "uri"
    }
  }
}
