{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow domain-event contract v1 (DRAFT, NOT production authorized)",
  "description": "Additive versioned transport contract; server verification, authorization and data minimization required by integration adapters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "source_product",
    "aggregate_id",
    "aggregate_revision",
    "occurred_at",
    "idempotency_key",
    "correlation_id"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "source_product": {
      "enum": [
        "flow",
        "flow-pro",
        "tourify",
        "heat",
        "werk",
        "bzar",
        "dreamstream",
        "54",
        "prez"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "aggregate_revision": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
